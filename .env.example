# NEØ local / deployment environment template
# Copy to .env.local for normal local development. Never commit real values.

# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-side Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET

# Public application origin. Set both to the same deployed HTTPS origin in production.
# VITE_PUBLIC_SITE_URL is public and is used for canonical/social URLs.
# PUBLIC_SITE_URL is server-side and is used for callbacks/absolute URLs.
VITE_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Generic card/QR/courier connector secrets MUST use this namespace.
# NEO_CONNECTOR_CARD_TERMINAL_API_KEY=
# NEO_CONNECTOR_QR_API_KEY=
# NEO_CONNECTOR_COURIER_TOKEN=

# Optional external providers — configure only when that provider is being enabled.
LOVABLE_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
AT_API_KEY=
AT_USERNAME=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Fail-closed outbound release. Review historical queued records before setting.
# Only messages created at or after this UTC instant can be dispatched.
NEO_OUTBOUND_ENABLED=false
NEO_OUTBOUND_CUTOFF=

# Worker phone alerts. Generate a VAPID pair with `npx web-push generate-vapid-keys`.
# Keep the private key and a random dispatch token (32+ characters) server-side.
# An HTTPS scheduler must POST /api/internal/worker-push with Authorization: Bearer <token>.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:alerts@example.com
NEO_PUSH_DISPATCH_TOKEN=
NEO_PUSH_DISPATCH_ENABLED=false

# Test-only / trusted environment variables (normally leave unset locally).
# PGHOST=
# LOVABLE_BROWSER_SUPABASE_ACCESS_TOKEN=
# NEO_SESSION_FILE=
